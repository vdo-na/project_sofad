FROM jenkins/jenkins:lts
USER root

# Устанавливаем необходимые утилиты, Python, SSH и Docker CLI
RUN apt-get update && apt-get install -y \
    curl \
    sshpass \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем библиотеки для запуска автотестов и линтера
RUN pip3 install --break-system-packages flake8 pytest pytest-asyncio httpx fastapi sqlalchemy psycopg[binary] pydantic pydantic-settings prometheus-fastapi-instrumentator redis

# Устанавливаем консольный клиент Docker
RUN curl -fsSL https://get.docker.com | sh